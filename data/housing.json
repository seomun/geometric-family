     ],
     "label": "우체통"
    },
    {
     "id": "t4",
     "need": [
      "m_garden"
     ],
     "label": "텃밭"
    },
    {
     "id": "t5",
     "need": [
      "o_gate"
     ],
     "label": "대문"
    }
   ],
   "cuts": [
    {
     "bg": "field",
     "text": "「다음 모임은 우리 집에서 하자.」 세 사람이 마당을 보았다.",
     "chars": [
      "nemo_dad.joy",
      "wife.joy",
      "dong_dad.warm"
     ]
    },
    {
     "bg": "field",
     "text": "평상을 놓고 담장을 세우니 골목이 정겨워졌다.",
     "chars": [
      "nemo_dad.joy",
      "dong_dad.warm"
     ]
    },
    {
     "bg": "field",
     "text": "이 나이엔 그냥 건강하면 된다. 마당에 웃음이 퍼졌다.",
     "chars": [
      "nemo_dad.joy",
      "wife.joy",
      "dong_dad.warm"
     ]
    }
   ],
   "reward": {
    "cozy": 40,
    "unlock": "entrance"
   }
