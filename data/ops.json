 "faq": [
  {
   "q": "진행 기록은 어디에 저장되나요?",
   "a": "이 기기 안에만 저장돼요. 앱을 지우면 기록도 지워지니, 바꾸기 전에는 설정의 백업 기능을 써 주세요."
  },
  {
   "q": "집은 다른 앱과 이어지나요?",
   "a": "같은 회사의 형제 앱이 같은 기기에 있으면 같은 집을 함께 꾸며요. 아이 앱끼리, 어른 앱끼리만 이어져요."
  },
  {
   "q": "소리나 큰 글씨는 어디서 바꾸나요?",
   "a": "위쪽 ⚙ 설정에서 소리·진동·큰 글씨·움직임 줄이기를 바꿀 수 있어요."
  },
  {
   "q": "광고는 어떻게 나오나요?",
   "a": "홈과 이야기 지도 아래에 작은 배너가 있고, 판 사이에 가끔 짧은 광고가 나와요. 선택해서 보는 광고는 안 봐도 괜찮아요."
  },
  {
   "q": "이야기를 다시 보고 싶어요.",
   "a": "설정의 「이야기 다시 보기」로 처음부터 다시 볼 수 있어요. 지도의 책 모양을 눌러도 그 장을 볼 수 있어요."
  },
  {
   "q": "진행을 처음부터 다시 하고 싶어요.",
   "a": "설정 맨 아래 「이 앱 기록 지우기」를 두 번 누르면 지워져요. 집은 그대로 남아요."
  }
