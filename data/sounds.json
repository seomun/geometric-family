 "voice": {
  "voice_c1_p1": {
   "file": null,
   "text": "오늘은 막둥이의 생일! 잔칫집에 가요."
  },
  "voice_c1_p2": {
   "file": null,
   "text": "어? 다리가 아주 좁네!"
  },
  "voice_c1_p3": {
   "file": null,
   "text": "동그라미 아저씨가 말했어요. \"큰 순서대로. 가자.\""
  },
  "voice_c1_e1": {
   "file": null,
   "text": "모두 무사히 건넜어요!"
  },
  "voice_c1_e2": {
   "file": null,
   "text": "어? 저 멀리서 \"뚝!\" 소리가 나요."
  },
  "voice_c2_p1": {
   "file": null,
   "text": "뚝! 무슨 소리지?"
  },
  "voice_c2_p2": {
   "file": null,
   "text": "세모 이모도 깜짝!"
  },
  "voice_c2_p3": {
   "file": null,
   "text": "같은 얼굴을 찾아봐요."
  },
  "voice_c2_e1": {
   "file": null,
   "text": "소리의 정체는 곶감이 떨어지는 소리였어요!"
  },
  "voice_c2_e2": {
   "file": null,
   "text": "곶감을 한 줄 받았어요. 마당에서 무언가 보여요."
  },
  "voice_c3_p1": {
   "file": null,
   "text": "마당에 아주 큰 무가 있어요!"
  },
  "voice_c3_p2": {
   "file": null,
   "text": "영차! 할머니가 당겨 봐요. 어? 안 뽑혀요."
  },
  "voice_c3_p3": {
   "file": null,
   "text": "다 같이 힘을 모아요! 흩어진 조각을 맞춰 보세요."
  },
  "voice_c3_e1": {
   "file": null,
   "text": "세모 이모와 동그라미 아저씨도 도와줘서… 쑥!"
  },
  "voice_c3_e2": {
   "file": null,
   "text": "어느새 해가 지고 깜깜해졌어요."
  },
  "voice_c4_p1": {
   "file": null,
   "text": "깜깜한 밤길이에요. 잔칫집이 보이지 않아요."
  },
  "voice_c4_p2": {
   "file": null,
   "text": "어? 하늘에 해님도 달님도 별님도 없어요!"
  },
  "voice_c4_p3": {
   "file": null,
   "text": "색을 칠해서 하늘을 밝혀 주세요."
  },
  "voice_c4_e1": {
   "file": null,
   "text": "달님이 환하게 길을 비춰 줘요."
  },
  "voice_c4_e2": {
   "file": null,
   "text": "저기 봐요! 잔칫집 불빛이 보여요!"
  },
  "voice_c5_p1": {
   "file": null,
   "text": "잔칫집에 도착! 그런데 바람이 후~ 불어와요."
  },
  "voice_c5_p2": {
   "file": null,
   "text": "세 가족이 각자 집을 지어요. 도형 조각을 맞춰 보세요!"
  },
  "voice_c5_e1": {
   "file": null,
   "text": "바람이 후~ 불어도 끄떡없어요!"
  },
  "voice_c5_e2": {
   "file": null,
   "text": "세 가족이 한자리에 모였어요. 막둥이, 생일 축하해!"
  }
 }
