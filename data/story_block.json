      "who": "nemo_mom.good",
      "text": "빈칸을 먼저 봐요."
     },
     {
      "who": "nemo_grandma.good",
      "text": "한 줄만 채우면 돼요."
     }
    ],
    "clear": [
     {
      "who": "nemo_kids.kid1",
