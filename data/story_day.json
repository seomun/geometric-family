 "prologue": [
  {
   "text": "막둥이가 아침에 눈을 떴다. 「오늘은 뭐 할까?」",
   "chars": [
    "baby.joy"
   ]
  },
  {
   "text": "칫솔이 쓱쓱 지나가자, 이에 묻은 얼룩이 사라졌다.",
   "chars": [
    "baby.joy"
   ],
   "mini": {
    "theme": "teeth",
    "level": 1,
    "app": "day"
   }
  },
  {
   "text": "엄마가 웃었다. 「이제 우리 막둥이가 닦아 볼까?」",
   "chars": [
    "nemo_mom.love"
   ],
   "mini": {
    "theme": "teeth",
    "level": 1,
    "app": "day"
   }
  }
 ],
 "chapters": {
  "1": {
   "title": "금도끼 은도끼",
   "tale": "axe",
   "faces": [
    "nemo_dad.worry",
    "dong_dad.warm",
    "nemo_dad.good"
   ],
   "midAt1": 2,
   "midAt2": 4,
   "start": [
    {
     "text": "막둥이가 칫솔을 들고 이 닦는 순서를 따라 했다. 쓱쓱!",
     "chars": [
      "baby.joy"
     ],
     "mini": {
      "theme": "teeth",
      "level": 1,
      "app": "day"
     }
    },
    {
     "text": "아빠가 도끼를 연못에 퐁당! 아빠는 깜짝 놀랐어요.",
     "chars": [
      "nemo_dad.worry"
     ],
     "bubble": "bang"
    }
   ],
   "mid": [
    {
     "after": 2,
     "cuts": [
      {
       "text": "동그라미 아저씨가 금도끼를 들고 물었어요. 「이게 아빠 도끼예요?」 아빠는 고개를 저었어요.",
       "chars": [
        "dong_dad.warm",
        "nemo_dad.good"
       ],
       "bubble": "question"
      }
     ]
    },
    {
     "after": 4,
     "cuts": [
      {
       "text": "은도끼도 아니래요. 「제 도끼는 쇠도끼예요.」",
       "chars": [
        "nemo_dad.good",
        "dong_dad.joy"
       ]
      }
     ]
    }
   ],
   "end": [
    {
     "text": "정직한 아빠는 반짝이는 도끼를 모두 받았어요. {baby}도 이를 반짝반짝 닦아요!",
     "chars": [
      "nemo_dad.love",
      "baby.joy"
     ],
     "bubble": "sparkle"
    }
   ],
   "say": {
    "start": [
     {
      "who": "nemo_dad.worry",
      "text": "오늘도 해 볼까?"
     },
     {
      "who": "dong_dad.warm",
      "text": "같이 하자!"
     },
     {
      "who": "nemo_dad.good",
      "text": "천천히 해도 돼."
     }
    ],
    "clear": [
     {
      "who": "nemo_dad.worry",
      "text": "잘했어!"
     },
     {
      "who": "dong_dad.warm",
      "text": "또 하나 끝났네."
     },
     {
      "who": "nemo_dad.good",
      "text": "멋져!"
     }
    ]
   }
  },
  "2": {
   "title": "세 마리 곰",
   "tale": "bears",
   "faces": [
    "dong_dad.joy",
    "wife.surprise",
    "wife.joy"
   ],
   "midAt1": 2,
   "midAt2": 4,
   "start": [
