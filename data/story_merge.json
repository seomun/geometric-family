        "nemo_kids.kid1",
        "dong_dad.warm"
       ],
       "bubble": "question"
      }
     ]
    }
   ],
   "end": [
    {
     "text": "용왕님의 병은 사실 외로움이었다. 토끼와 거북이 한 상에서 해초 전을 나눠 먹으니 금세 기운이 났다.",
