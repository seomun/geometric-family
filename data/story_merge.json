        "husband.joy",
        "wife.joy",
        "dong_dad.joy"
       ],
       "bubble": "question"
      }
     ]
    },
    {
     "after": 7,
     "cuts": [
      {
       "text": "네 친구가 탑처럼 올라서서 함께 노래하자 집 안의 허깨비 도둑들이 놀라 달아났다.",
