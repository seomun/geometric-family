     {
      "who": "nemo_dad.worry",
      "text": "오늘은 무엇을 합쳐 볼까요?"
     },
     {
      "who": "nemo_mom.good",
      "text": "조금만 더 모이면 돼요."
     },
     {
      "who": "nemo_dad.surprise",
      "text": "천천히, 하나씩이요."
     }
    ],
    "clear": [
     {
      "who": "nemo_dad.worry",
      "text": "잘 합쳤어요!"
     },
     {
      "who": "nemo_mom.good",
      "text": "또 하나 커졌어요."
     },
     {
      "who": "nemo_dad.surprise",
      "text": "이대로 쭉이요."
