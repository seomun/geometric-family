    "art.swallow",
    "nemo_dad.joy"
   ],
   "midAt1": 4,
   "midAt2": 7,
   "start": [
    {
     "text": "다리를 다친 제비를 흥부(네모 아빠)가 정성껏 싸매 주었다.",
     "chars": [
      "nemo_dad.love",
