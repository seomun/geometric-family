        "nemo_kids.kid3"
       ],
       "bubble": "sparkle"
      }
     ]
    }
   ],
   "end": [
    {
     "text": "남매는 동아줄을 타고 올라가 해님과 달님이 되었다. 바람 호랑이는 엉덩방아를 찧고 허허 웃었다.",
